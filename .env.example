# 관리자 글쓰기 화면(/admin) 설정. 자세한 발급 방법은 docs/admin-editor.md 참고.
# 로컬: 이 파일을 .env.local 로 복사해 값을 채운다. 프로덕션: Vercel Project Settings > Environment Variables.

# GitHub OAuth App (로컬/프로덕션 각각 발급, callback URL 이 다름)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# 로그인을 허용할 단 하나의 GitHub 계정 숫자 ID (https://api.github.com/users/<login> 의 id)
ADMIN_GITHUB_ID=

# 세션 쿠키 서명 키 (예: openssl rand -base64 48)
ADMIN_SESSION_SECRET=

# 글/이미지를 커밋할 fine-grained PAT (이 저장소 Contents: Read and write 만)
GITHUB_CONTENT_TOKEN=
GITHUB_REPO=seonghoho/tech-book
GITHUB_BRANCH=master

# 예약 발행 (프로덕션만): Vercel Deploy Hook URL, Cron 인증 키
VERCEL_DEPLOY_HOOK_URL=
CRON_SECRET=
